# Prisma SASE / SD-WAN Authentication
# Option 1: Service Account (Recommended)
PRISMA_SASE_CLIENT_ID=your-service-account-client-id
PRISMA_SASE_CLIENT_SECRET=your-service-account-client-secret
PRISMA_SASE_TSG_ID=your-tenant-service-group-id

# Option 2: Auth Token
# PRISMA_SASE_AUTH_TOKEN=your-jwt-auth-token

# Controller / Region (Optional, default is api.sase.paloaltonetworks.com)
# PRISMA_SASE_CONTROLLER=https://api.sase.paloaltonetworks.com
# PRISMA_SASE_REGION=us-east-1

# Exporter Server Configuration
EXPORTER_HOST=0.0.0.0
EXPORTER_PORT=9850
SCRAPE_INTERVAL=60
METRICS_TIMEOUT=30
LOG_LEVEL=INFO
